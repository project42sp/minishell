{
   readline_all
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libreadline.so.*
}

{
   tinfo_all
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   obj:*/libtinfo.so.*
}

{
   readline_indirect
   Memcheck:Leak
   ...
   obj:*/libreadline.so.*
}

{
   tinfo_indirect
   Memcheck:Leak
   ...
   obj:*/libtinfo.so.*
}
{
   suppress_execved_usr_bin
   Memcheck:Leak
   match-leak-kinds: all
   ...
   obj:/usr/bin/*
}

{
   suppress_execved_bin
   Memcheck:Leak
   match-leak-kinds: all
   ...
   obj:/bin/*
}
